// loki-agent :: dev layout + a tmux pane for live-monitoring inter-agent chat.
// Launch with:  zellij --layout loki-agent
//
// The bottom-right pane attaches to a tmux session named "agents" (creating it
// if absent). tmux runs *inside* this zellij pane — zellij's default mode is
// "locked" so Ctrl-b passes straight through to tmux. Rename the session below
// if your agent comms uses a different one.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="loki" focus=true {
        pane split_direction="vertical" {
            pane size="24%" name="  files" {
                command "yazi"
            }
            pane split_direction="horizontal" {
                pane name="  shell" focus=true size="62%"
                pane name="  agents" {
                    command "bash"
                    args "-lc" "tmux attach -t agents 2>/dev/null || tmux new -s agents"
                }
            }
        }
    }
}
